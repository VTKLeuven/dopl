# Dopl environment. Copy to `.env` at the repo root (used by web, worker and
# the Prisma CLI). Every variable is documented; secrets never go in git.
#
#   cp .env.example .env && openssl rand -base64 32   # for the *_SECRET/_KEY values

# ─── Core ──────────────────────────────────────────────────────────────────
# Public base URL of the app (production: https://dopl.vtk.be)
APP_URL=http://localhost:3000
# Postgres 17 + pgvector (docker/compose.dev.yml exposes it on 54320)
DATABASE_URL=postgresql://dopl:dopl@localhost:54320/dopl
# Separate database for integration & e2e tests (created by docker/postgres/init-dev.sql)
DATABASE_URL_TEST=postgresql://dopl:dopl@localhost:54320/dopl_test
# 32 random bytes, base64. Encrypts secrets stored in the DB (webhook URLs, SSO client secrets).
DOPL_ENCRYPTION_KEY=
# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ─── Auth (Better Auth) ────────────────────────────────────────────────────
# 32 random bytes, base64. Signs sessions and tokens.
BETTER_AUTH_SECRET=
# Must equal the public URL (OAuth redirect URIs derive from it)
BETTER_AUTH_URL=http://localhost:3000
# Google sign-in (optional; leave empty to hide the button).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional hint that pre-selects the Workspace account, e.g. vtk.be (not a gate — invites are).
GOOGLE_HOSTED_DOMAIN=
# Origins of the OIDC identity providers an admin may add in Settings → Authentication,
# comma-separated, no wildcards (production: https://vtk.be). Dopl refuses to contact any
# other origin. Note: these origins also pass Better Auth's origin and redirect checks (D-127).
SSO_TRUSTED_ORIGINS=

# ─── Email (SMTP) ──────────────────────────────────────────────────────────
# Dev: Mailpit (http://localhost:8025). Prod: Google Workspace SMTP relay
# (smtp-relay.gmail.com, port 587, STARTTLS, SMTP AUTH as the sender user).
SMTP_HOST=localhost
SMTP_PORT=1025
# true only for implicit TLS on port 465; port 587 upgrades with STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Dopl <noreply@vtk.be>"

# ─── File storage ──────────────────────────────────────────────────────────
# local (dev/test) | s3 (prod: Garage or any S3-compatible store)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=dopl
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Worker ────────────────────────────────────────────────────────────────
WORKER_HEALTH_PORT=3001

# ─── Later phases (leave empty until then) ─────────────────────────────────
# Phase 3 — Cloudflare Turnstile for public forms (optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Phase 7 — the Gmail service account, Pub/Sub and the agent SSH key are worker-only
# secrets: they go in worker.env (see worker.env.example), never here (D-027).
# Dev and CI only: fake mailboxes in this directory (relative to the repo root) instead of Gmail.
# Never set in production (the worker refuses to start). e2e specs write messages here.
GMAIL_FAKE_DIR=
# Phase 5b — OpenAI-compatible embeddings endpoint on the AI server
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
# Phase 8 — the AI teammate. Hermes' API key, Warpgate and the SSH key are worker-only
# secrets in worker.env (D-027). The agent's runtime URL is set in Settings → AI teammate.
# Dev and CI only (the worker refuses these in production):
#   HERMES_FAKE_PORT       serve a fake Hermes that calls Dopl's MCP tools (the seed points the agent at it)
#   HERMES_FAKE_MCP_TOKEN  the MCP token it sends; `pnpm db:seed` registers it for the agent
#   AGENT_EXEC_FAKE        canned command output instead of SSH
HERMES_FAKE_PORT=
HERMES_FAKE_MCP_TOKEN=
AGENT_EXEC_FAKE=false
