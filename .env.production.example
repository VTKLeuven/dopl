# Dopl in production (docs/ops/deploy.md). On the server:
#
#   cp .env.production.example .env
#   sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 24)|" .env
#   sed -i "s|^BETTER_AUTH_SECRET=.*|BETTER_AUTH_SECRET=$(openssl rand -base64 32)|" .env
#   sed -i "s|^DOPL_ENCRYPTION_KEY=.*|DOPL_ENCRYPTION_KEY=$(openssl rand -base64 32)|" .env
#
# then fill in the domain and the SMTP relay below. Back this file up somewhere
# safe: without DOPL_ENCRYPTION_KEY, stored webhook URLs and SSO secrets can't be
# read, and without BETTER_AUTH_SECRET everyone is signed out.
# Worker-only secrets (Gmail, Hermes, the agent's SSH key) go in worker.env, never here.

# ─── Where it runs ─────────────────────────────────────────────────────────
# The public URL. BETTER_AUTH_URL must be the same.
APP_URL=https://dopl.vtk.be
BETTER_AUTH_URL=https://dopl.vtk.be
# true: ./dopl also runs Caddy, which gets a certificate for DOPL_DOMAIN and
# serves HTTPS on ports 80/443. false: put your own reverse proxy in front of
# 127.0.0.1:DOPL_PORT (docs/ops/deploy.md §Reverse proxy).
DOPL_CADDY=false
DOPL_DOMAIN=dopl.vtk.be
# The port web listens on (on 127.0.0.1) for your own reverse proxy.
DOPL_PORT=3000
# Image tag: `latest`, or a commit SHA from GitHub to pin a version.
DOPL_VERSION=latest
TZ=Europe/Brussels
LOG_LEVEL=info

# ─── Database (the postgres container) ─────────────────────────────────────
POSTGRES_USER=dopl
POSTGRES_DB=dopl
# Random, long; the same value goes in DATABASE_URL.
POSTGRES_PASSWORD=change-me
# Keep host `postgres` (the service name) and put the password from above in it.
DATABASE_URL=postgresql://dopl:change-me@postgres:5432/dopl

# ─── Secrets (32 random bytes, base64 each) ────────────────────────────────
BETTER_AUTH_SECRET=
DOPL_ENCRYPTION_KEY=

# ─── Email ─────────────────────────────────────────────────────────────────
# Invites, magic links, password resets and digests. Accounts are invite-only,
# so nobody can join until this works. Google Workspace SMTP relay: register
# the server's public IP in Admin console → Apps → Gmail → Routing → SMTP relay,
# or use SMTP AUTH with an app password of the sending user.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Dopl <noreply@vtk.be>"

# ─── Files ─────────────────────────────────────────────────────────────────
# local = the `uploads` volume shared by web and worker, included in backups.
# s3 = any S3-compatible store (Garage, MinIO…): fill in the S3_* values instead.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/uploads
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=dopl
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Backups (the backup container) ────────────────────────────────────────
# Daily time (TZ above), how many days to keep, and the host directory
# (relative to docker/) the dumps land in. Copy it off the server.
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups

# ─── Worker ────────────────────────────────────────────────────────────────
WORKER_HEALTH_PORT=3001

# ─── Optional ──────────────────────────────────────────────────────────────
# Google sign-in (needs an OAuth client; redirect URI <APP_URL>/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=
# Cloudflare Turnstile on public forms.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
