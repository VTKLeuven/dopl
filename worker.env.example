# Worker-only secrets (D-027). Copy to worker.env next to .env; only the worker
# loads it, and in production only the worker container mounts ./secrets.
# See docs/ops/gmail-setup.md.

# Phase 7 — Gmail: the service account's JSON key (domain-wide delegation),
# mounted read-only into the worker at /run/secrets.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# projects/<project>/topics/<topic> Gmail publishes changes to (users.watch)
GMAIL_PUBSUB_TOPIC=
# projects/<project>/subscriptions/<subscription> the worker pulls from; empty = poll every 5 min
GMAIL_PUBSUB_SUBSCRIPTION=

# Phase 8 — the AI teammate (docs/ops/agent-setup.md)
# Hermes' API_SERVER_KEY. The env var's name is set per agent in Settings → AI teammate.
HERMES_API_KEY=
# Warpgate's SSH listener; commands log in as <AGENT_SSH_USER>:<target>
WARPGATE_HOST=
WARPGATE_PORT=2222
AGENT_SSH_USER=dopl-agent
# Warpgate's host key fingerprint, as `ssh-keygen -lf` prints it (SHA256:…); required
WARPGATE_HOST_KEY=
# The dopl-agent user's private key (ed25519), mounted read-only at /run/secrets
AGENT_SSH_KEY_FILE=
# Hard timeout per command, in seconds
AGENT_EXEC_TIMEOUT_SEC=300
